# Secure File Vault configuration.
# Copy to ".env" and fill in — or let setup.sh / your AI agent do it (AGENTS.md).
# The real .env must never be committed (it is in .gitignore).

# --- Encryption key (REQUIRED, no default) ---
# 32 random bytes, base64-encoded. Generate with: openssl rand -base64 32
# !! Back this up offline (password manager / paper). If you lose it, every
# !! stored file becomes permanently unrecoverable ciphertext.
VAULT_KEY_B64=

# --- Where the vault is reached (used in login emails) ---
# Local testing: http://localhost:8080   Production: https://vault.example.com
PUBLIC_URL=http://localhost:8080

# --- Email delivery for login codes ---
# console = codes/links print to the container log (local use and testing)
# resend  = real email via https://resend.com (free tier is plenty)
EMAIL_MODE=console
RESEND_API_KEY=
# The From address for login emails. With Resend it must be on a domain you
# have verified in Resend, e.g. "Vault <vault@mail.example.com>".
EMAIL_FROM=Vault <vault@example.com>

# --- Cookies ---
# Set true as soon as the vault is served over HTTPS (tunnel/reverse proxy),
# false only for plain-HTTP localhost use.
COOKIE_SECURE=false

# --- First-run admin account (created only if the database is empty) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Admin
